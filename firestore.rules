rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(userId) { return signedIn() && request.auth.uid == userId; }
    function isMember() { return signedIn() && request.auth.uid in resource.data.memberIds; }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId);
      allow update, delete: if isSelf(userId);
    }

    match /reactions/{reactionId} {
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow read, update: if isMember();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
